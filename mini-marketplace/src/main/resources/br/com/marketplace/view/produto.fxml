<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane
       xmlns="http://javafx.com/javafx/21"
       xmlns:fx="http://javafx.com/fxml/1"
       styleClass="detalhes-pagina">

       <!-- CABEÇALHO -->

       <top>
              <HBox alignment="CENTER_LEFT"
                     spacing="20"
                     styleClass="detalhes-cabecalho">

                     <padding>
                            <Insets top="18" right="35" bottom="18" left="35" />
                     </padding>

                     <Label text="MINI MARKETPLACE"
                            styleClass="detalhes-logo" />

                     <Region HBox.hgrow="ALWAYS" />

                     <Button fx:id="lblQuantidadeCarrinho"
                            text="Carrinho (0)"
                            styleClass="detalhes-indicador"
                            onAction="#abrirCarrinho" />

              </HBox>
       </top>

       <!-- CONTEÚDO PRINCIPAL -->

       <center>

              <ScrollPane fitToWidth="true"
                     fitToHeight="false"
                     hbarPolicy="NEVER"
                     styleClass="detalhes-scroll">

                     <content>

                            <VBox spacing="25"
                                   alignment="TOP_CENTER">

                                   <padding>
                                          <Insets top="30" right="35"
                                                 bottom="35" left="35" />
                                   </padding>

                                   <!-- BOTÃO VOLTAR -->

                                   <HBox maxWidth="1100"
                                          minWidth="0"
                                          alignment="CENTER_LEFT">

                                          <Button text="← Voltar ao catálogo"
                                                 onAction="#voltarAoCatalogo"
                                                 styleClass="botao-voltar" />

                                   </HBox>

                                   <!-- CARD DE DETALHES -->

                                   <HBox spacing="24"
                                          alignment="CENTER"
                                          maxWidth="1100"
                                          minWidth="0"
                                          styleClass="detalhes-card">

                                          <padding>
                                                 <Insets top="24" right="24"
                                                        bottom="24" left="24" />
                                          </padding>

                                          <!-- IMAGEM -->

                                          <StackPane fx:id="painelImagemDetalhes" prefWidth="340"
                                                 prefHeight="380"
                                                 minWidth="240"
                                                 maxWidth="360"
                                                 HBox.hgrow="SOMETIMES"
                                                 styleClass="detalhes-imagem">

                                                 <Label fx:id="lblImagemIndisponivel"
                                                        text="Imagem indisponível"
                                                        styleClass="detalhes-imagem-texto" />

                                                 <ImageView fx:id="imagemProduto"
                                                        fitWidth="${painelImagemDetalhes.width - 24}"
                                                        fitHeight="340"
                                                        preserveRatio="true"
                                                        smooth="true" />

                                          </StackPane>

                                          <!-- INFORMAÇÕES -->

                                          <VBox spacing="16"
                                                 minWidth="0"
                                                 alignment="CENTER_LEFT"
                                                 HBox.hgrow="ALWAYS">

                                                 <Label fx:id="lblCategoria"
                                                        styleClass="detalhes-categoria" />

                                                 <Label fx:id="lblNome"
                                                        wrapText="true"
                                                        styleClass="detalhes-nome" />

                                                 <Label fx:id="lblPreco"
                                                        styleClass="detalhes-preco" />

                                                 <Separator />

                                                 <Label text="Descrição do produto"
                                                        styleClass="detalhes-subtitulo" />

                                                 <Label fx:id="lblDescricao"
                                                        wrapText="true"
                                                        maxWidth="Infinity"
                                                        styleClass="detalhes-descricao" />

                                                 <Button text="Adicionar ao carrinho"
                                                        onAction="#adicionarAoCarrinho"
                                                        maxWidth="Infinity"
                                                        styleClass="detalhes-botao-adicionar" />

                                                 <Label fx:id="lblMensagem"
                                                        wrapText="true"
                                                        styleClass="detalhes-mensagem" />

                                          </VBox>

                                   </HBox>

                            </VBox>

                     </content>

              </ScrollPane>

       </center>

</BorderPane>